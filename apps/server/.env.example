DATABASE_URL=postgresql://postgres:password@localhost:5432/Intelligent-QA-Assistant
BETTER_AUTH_SECRET=replace-with-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development

OBJECT_STORAGE_ENDPOINT=127.0.0.1
OBJECT_STORAGE_PORT=9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=qa-documents
OBJECT_STORAGE_USE_SSL=false

OPENAI_API_KEY=replace-with-openai-key
ANTHROPIC_API_KEY=
QA_DEFAULT_MODEL=openai:gpt-4.1
QA_ALLOWED_MODELS=openai:gpt-4.1,anthropic:claude-3-5-sonnet-latest
QA_TEST_MODE=false
QA_FAKE_AI=false
QA_FAKE_STORAGE=false
BETTER_AUTH_SECURE_COOKIES=true
